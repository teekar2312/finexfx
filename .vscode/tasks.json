{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Dev Server",
      "type": "shell",
      "command": "bun run dev",
      "problemMatcher": [],
      "isBackground": true,
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "Lint",
      "type": "shell",
      "command": "bun run lint",
      "problemMatcher": "$eslint-stylish"
    },
    {
      "label": "DB Push",
      "type": "shell",
      "command": "bun run db:push",
      "problemMatcher": []
    },
    {
      "label": "Seed Data",
      "type": "shell",
      "command": "curl -X POST http://localhost:3000/api/seed",
      "problemMatcher": []
    },
    {
      "label": "Build Production",
      "type": "shell",
      "command": "bun run build",
      "problemMatcher": []
    }
  ]
}
